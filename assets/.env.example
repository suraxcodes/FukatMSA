# ---------------------------------------------------------------------------
# Fukat MSA configuration example
#
# Copy to assets/.env for local development, or pass the same keys as
# --dart-define flags in CI / release builds:
#
#   flutter build apk --dart-define=TMDB_API_TOKEN=xxxx --dart-define=SUPABASE_URL=... 
#
# --dart-define always wins over this file.
#
# NOTE: nothing in this file is truly secret once the app ships. Assume every
# value is extractable from the APK. What actually protects your data is
# Supabase Row Level Security — configure it (see docs/SUPABASE.md).
# ---------------------------------------------------------------------------

# --- TMDB (required) -------------------------------------------------------
# Get a free v4 read access token at https://www.themoviedb.org/settings/api
# Then paste it here. Without it, no catalogue (movies, anime, TV) can load.
# Leave blank only if you are using TMDB_API_KEY (v3) instead.
TMDB_API_KEY=
TMDB_API_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Supabase (optional) ---------------------------------------------------
# Leave blank to run in local-only mode: watchlist and progress stay on device.
SUPABASE_URL=https://trryvulazqwloqnfjwak.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRycnl2dWxhenF3bG9xbmZqd2FrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAyNDUyNzYsImV4cCI6MjA5NTgyMTI3Nn0.xK0g_IDTm7gqBqxcn81pPtdZuyc3xK2AQqutKTxbC_A

# --- Providers (optional) --------------------------------------------------
# Remote provider list. Leave blank to use the bundled assets/remote_config.json
REMOTE_CONFIG_URL=
# Ad-block selector/domain list, served as JSON
ADBLOCK_CONFIG_URL=https://gist.githubusercontent.com/suraxcodes/3f2cd29abb4349c29417938eec4132d7/raw
# Self-hosted HLS proxy (URL rewriter only — NOT a stream provider)
PROXIFY_STREAMS_URL=https://proxify-streamsmsa.onrender.com
# Shared secret sent as X-Api-Key if you gate your proxy
PROXIFY_SHARED_SECRET=
# Stremio addon base URL for the native_stremio engine.
# Leave EMPTY unless you have a debrid-backed addon — public addons return
# torrent infoHashes, which media_kit cannot play. Example:
#   STREMIO_ADDON_URL=https://torrentio.strem.fun/realdebrid=YOUR_KEY
STREMIO_ADDON_URL=
